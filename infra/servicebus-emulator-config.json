{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        "Queues": [
          { "Name": "payments-rebus", "Properties": { "RequiresDuplicateDetection": false } },
          { "Name": "ex2-orders-rebus", "Properties": { "RequiresDuplicateDetection": false } },
          { "Name": "ex2-shipping-rebus", "Properties": { "RequiresDuplicateDetection": false } },
          { "Name": "ex3-payments-rebus", "Properties": { "RequiresDuplicateDetection": false } },
          { "Name": "error", "Properties": { "RequiresDuplicateDetection": false } },
          {
            "Name": "payments",
            "Properties": {
              "DeadLetteringOnMessageExpiration": true,
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT5M",
              "LockDuration": "PT1M",
              "MaxDeliveryCount": 5,
              "RequiresDuplicateDetection": true,
              "RequiresSession": false,
              "ForwardTo": "",
              "ForwardDeadLetteredMessagesTo": ""
            }
          },
          {
            "Name": "orders-rebus",
            "Properties": {
              "DeadLetteringOnMessageExpiration": true,
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT20S",
              "LockDuration": "PT1M",
              "MaxDeliveryCount": 5,
              "RequiresDuplicateDetection": false,
              "RequiresSession": false,
              "ForwardTo": "",
              "ForwardDeadLetteredMessagesTo": ""
            }
          }
        ],
        "Topics": [
          {
            "Name": "Contracts/Contoso.Messaging.Contracts.PaymentCharged",
            "Properties": { "RequiresDuplicateDetection": false },
            "Subscriptions": [
              { "Name": "orders-rebus", "Properties": { "ForwardTo": "orders-rebus" } },
              { "Name": "ex3-payments-rebus", "Properties": { "ForwardTo": "ex3-payments-rebus" } }
            ]
          },
          {
            "Name": "Contracts/Contoso.Messaging.Contracts.PaymentFailed",
            "Properties": { "RequiresDuplicateDetection": false },
            "Subscriptions": [
              { "Name": "ex3-payments-rebus", "Properties": { "ForwardTo": "ex3-payments-rebus" } }
            ]
          },
          {
            "Name": "Contracts/Contoso.Messaging.Contracts.OrderShipped",
            "Properties": { "RequiresDuplicateDetection": false },
            "Subscriptions": [
              { "Name": "ex2-orders-rebus", "Properties": { "ForwardTo": "ex2-orders-rebus" } }
            ]
          },
          {
            "Name": "order-events",
            "Properties": {
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT5M",
              "RequiresDuplicateDetection": true
            },
            "Subscriptions": [
              {
                "Name": "billing",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": true,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 5,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "only-order-placed",
                    "Properties": {
                      "FilterType": "Correlation",
                      "CorrelationFilter": {
                        "Label": "OrderPlaced"
                      }
                    }
                  }
                ]
              },
              {
                "Name": "shipping",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": true,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 5,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "payments-and-stock",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "sys.Label IN ('PaymentCharged','StockReserved')"
                      }
                    }
                  }
                ]
              },
              {
                "Name": "analytics",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": true,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 5,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                }
              },
              {
                "Name": "orders-wolverine",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": true,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 5,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                }
              }
            ]
          }
        ]
      }
    ],
    "Logging": {
      "Type": "File"
    }
  }
}