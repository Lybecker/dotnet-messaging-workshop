{
  "_comment": "Self-hosted / Docker: load at boot (load_definitions in rabbitmq.conf) or 'rabbitmqadmin import'. Import is ADDITIVE: it creates and updates, it never deletes. Good for dev and docker-compose; for test/prod use the pipeline script (rabbitmq/pipeline) or the Topology Operator.",
  "vhosts": [ { "name": "contoso" } ],
  "exchanges": [
    { "name": "orders.order-placed.v1", "vhost": "contoso", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    { "name": "billing.order-placed",     "vhost": "contoso", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } },
    { "name": "billing.order-placed.dlq", "vhost": "contoso", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } }
  ],
  "bindings": [
    { "source": "orders.order-placed.v1", "vhost": "contoso", "destination": "billing.order-placed", "destination_type": "queue", "routing_key": "#", "arguments": {} }
  ],
  "policies": [
    { "vhost": "contoso", "name": "billing.order-placed.defaults", "pattern": "^billing\\.order-placed$", "apply-to": "queues", "priority": 10,
      "definition": { "dead-letter-exchange": "", "dead-letter-routing-key": "billing.order-placed.dlq", "delivery-limit": 10, "message-ttl": 1209600000 } }
  ]
}
